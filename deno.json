{
  "tasks": {
    "build": "deno run --allow-read --allow-write build.ts",
    "serve": "deno run --allow-net --allow-read jsr:@std/http/file-server --port 8000 dist",
    "dev": "deno task build && deno task serve"
  },
  "imports": {
    "marked": "npm:marked@14.1.4",
    "marked-highlight": "npm:marked-highlight@2.1.4",
    "prismjs": "npm:prismjs@1.29.0"
  },
  "fmt": {
    "lineWidth": 100
  }
}
